# =============================================================================
# AEON AI Hedge Fund Manager -- Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# Or run the installation wizard:
#   bash install.sh
#
# NEVER commit the real .env file -- it is listed in .gitignore.
# =============================================================================


# ---------------------------------------------------------------------------
# LLM Provider
# ---------------------------------------------------------------------------
# Which LLM backend AEON uses for reasoning and research.
# Supported: "ollama" (local, free), "bedrock" (AWS cloud)

AEON_LLM_PROVIDER=ollama

# --- Ollama (local, free) ---
# Install:  https://ollama.com
# Pull a model:  ollama pull llama3.2
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Amazon Bedrock (cloud API) ---
# Uses your AWS credentials to call models hosted on Bedrock.
# https://console.aws.amazon.com/bedrock
# BEDROCK_AWS_ACCESS_KEY_ID=
# BEDROCK_AWS_SECRET_ACCESS_KEY=
# BEDROCK_AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0


# ---------------------------------------------------------------------------
# Investment Focus / Guidance Prompt
# ---------------------------------------------------------------------------
# A free-text directive that steers the agent's research focus.
# This is THE most important setting -- it tells AEON what to research.
#
# Examples:
#   "Focus on AI and semiconductor stocks, moderate risk appetite"
#   "Research crypto DeFi protocols and emerging L2 chains"
#   "Conservative value investing: find undervalued blue-chip stocks"
#   "Monitor NVDA, TSLA, and AAPL for swing trading opportunities"
AEON_GUIDANCE_PROMPT="General market research: explore opportunities across stocks and crypto, moderate risk appetite."


# ---------------------------------------------------------------------------
# User Settings
# ---------------------------------------------------------------------------
# Your name and email for personalized updates.
AEON_USER_EMAIL=
AEON_USER_NAME=


# ---------------------------------------------------------------------------
# Research Settings
# ---------------------------------------------------------------------------
# Daily LLM inference budget in USD (Ollama is free, this matters for cloud LLMs)
AEON_RESEARCH_BUDGET_DAILY=1.00

# Market focus areas (comma-separated)
AEON_MARKET_FOCUS=crypto,stocks

# How often to send email updates when findings warrant (minutes)
AEON_UPDATE_FREQUENCY_MINUTES=30

# Max tool calls per research chain
AEON_MAX_RESEARCH_DEPTH=10

# Base sleep between research cycles (seconds)
AEON_SLEEP_BASE_SECONDS=120


# ---------------------------------------------------------------------------
# Market Data Sources
# ---------------------------------------------------------------------------
# Crypto data is always free via Coinbase, Binance, and CoinGecko (no keys).
#
# Stock/ETF data providers (all optional, configure any combination):
#   Finnhub      — 60 req/min free tier, requires API key (recommended)
#   Alpha Vantage — 25 req/day free tier, requires API key
#   Yahoo Finance — no key needed, but rate-limits aggressively (disabled by default)
#
# AEON tries providers in order: Finnhub → Alpha Vantage → Yahoo Finance.

# Finnhub (recommended for stocks) — free key at https://finnhub.io/register
# FINNHUB_API_KEY=

# Alpha Vantage — free key at https://www.alphavantage.co/support/#api-key
# ALPHAVANTAGE_API_KEY=

# Yahoo Finance fallback (no key needed, but aggressive rate limits)
AEON_YAHOO_FINANCE_ENABLED=false


# ---------------------------------------------------------------------------
# Search Provider
# ---------------------------------------------------------------------------
# Primary web search for market research.
# Options: "duckduckgo" (free, can be rate-limited), "serpapi" (paid, reliable),
#          "brave" (paid, fast, 2000 free queries/month)
AEON_SEARCH_PROVIDER=duckduckgo

# SerpAPI key (only needed if AEON_SEARCH_PROVIDER=serpapi)
# 100 free searches/month, then paid plans.
# https://serpapi.com/manage-api-key
# SERPAPI_KEY=

# Brave Search API key (needed if AEON_SEARCH_PROVIDER=brave, or as supplementary source)
# 2000 free queries/month on the free plan.
# https://brave.com/search/api/
# BRAVE_API_KEY=


# ---------------------------------------------------------------------------
# Social / Sentiment APIs (optional)
# ---------------------------------------------------------------------------
# Twitter/X Bearer Token for sentiment analysis.
# Enhances research with real-time social sentiment data.
# https://developer.x.com/en/portal/dashboard
# TWITTER_BEARER_TOKEN=


# ---------------------------------------------------------------------------
# Email -- SMTP (Outbound)
# ---------------------------------------------------------------------------
# AEON sends research updates and recommendations via email.
# Gmail users: use smtp.gmail.com:587 with an App Password.
# https://myaccount.google.com/apppasswords

AEON_SMTP_HOST=
AEON_SMTP_PORT=587
AEON_SMTP_USER=
AEON_SMTP_PASSWORD=
AEON_SMTP_USE_TLS=true

# From address and default recipient
AEON_EMAIL_SENDER=
AEON_EMAIL_RECIPIENT=


# ---------------------------------------------------------------------------
# Email -- IMAP (Inbound for steering via email replies)
# ---------------------------------------------------------------------------
# AEON can read your email replies to steer its research.
# Gmail users: use imap.gmail.com:993 with the same App Password.

AEON_IMAP_HOST=
AEON_IMAP_USER=
AEON_IMAP_PASSWORD=


# ---------------------------------------------------------------------------
# Data Directory
# ---------------------------------------------------------------------------
# Where AEON stores its databases and logs.
AEON_DATA_DIR=data


# ---------------------------------------------------------------------------
# Restricted Mode (optional)
# ---------------------------------------------------------------------------
# When true, AEON requires human approval via email before taking certain
# actions. Useful for cautious operation. Default: false.
# AEON_RESTRICTED_MODE=false
